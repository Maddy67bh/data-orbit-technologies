<style>
:root{--bg:#f6f4ec;--ink:#192c23;--green:#163d2d;--gold:#bd9b5d;--muted:#657168;--white:#fff}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,Arial,sans-serif;line-height:1.65}
a{color:inherit}
.wrap{width:min(1120px,90%);margin:auto}
nav{display:flex;align-items:center;justify-content:space-between;padding:24px 0}
.brand{font-size:13px;letter-spacing:2px;font-weight:800;text-decoration:none}
.brand span{display:block;font-size:10px;color:var(--muted);letter-spacing:3px}
.navlink{font-size:13px;text-decoration:none;border-bottom:1px solid var(--gold);padding-bottom:4px}
.hero{background:var(--green);color:#fff;padding:74px 0 86px;overflow:hidden}
.kicker{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#dfc28c}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
h1{font-family:Georgia,serif;font-size:clamp(42px,6vw,76px);line-height:1.04;letter-spacing:-2px;font-weight:400;margin:20px 0}
h1 em{color:#d8bb82;font-weight:400}
.lead{max-width:570px;color:#e0e8e0;font-size:17px}
.actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:30px}
.btn{display:inline-block;padding:13px 19px;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:.5px;border:1px solid #d7bd89}
.btn.gold{background:#d7bd89;color:#192c23}
.btn.light{color:#fff}
.visual{min-height:350px;border:1px solid #688071;border-radius:18px;padding:20px;background:linear-gradient(145deg,#234b39,#10251c);box-shadow:0 25px 70px #07150e55}
.visual img{width:100%;height:170px;object-fit:cover;border-radius:10px;opacity:.86}
.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:15px}
.metric{background:#ffffff0e;border:1px solid #ffffff19;padding:13px 9px;border-radius:8px}
.metric strong{display:block;color:#e2c58d;font-size:20px}
.metric span{font-size:10px;color:#dce5dc}
.bar-title{font-size:11px;color:#e7eadf;margin:14px 0 8px}
.bars{height:65px;display:flex;align-items:end;gap:8px}
.bars i{flex:1;background:linear-gradient(#dfc18b,#8ca58a);border-radius:4px 4px 0 0}
section.content{padding:75px 0}
.eyebrow{color:#8d713e;text-transform:uppercase;letter-spacing:2px;font-size:11px;font-weight:700}
h2{font:400 clamp(31px,4vw,47px)/1.15 Georgia,serif;margin:12px 0 18px}
.intro{max-width:740px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px;margin-top:32px}
.card{padding:24px;background:#fff;border:1px solid #e7e3d8;border-radius:12px}
.card .num{color:#a1844e;font-size:12px;letter-spacing:2px}
.card h3{font-size:17px;margin:13px 0 8px}
.card p,.card li{color:var(--muted);font-size:13px}
.card ul{padding-left:18px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center}
.photo{width:100%;height:360px;object-fit:cover;border-radius:14px}
.steps{display:grid;gap:17px;margin-top:24px}
.step{display:grid;grid-template-columns:42px 1fr;gap:12px}
.step b{color:#a1844e}
.step h3{font-size:15px;margin:0}
.step p{font-size:13px;color:var(--muted);margin:4px 0}
.cta{background:#e9e5d9;border-radius:16px;padding:38px;margin-top:25px;display:flex;justify-content:space-between;align-items:center;gap:25px}
.cta p{color:var(--muted);max-width:600px}
footer{padding:27px 0;border-top:1px solid #ddd8ca;font-size:12px;color:var(--muted)}
@media(max-width:760px){.hero-grid,.split{grid-template-columns:1fr}.hero{padding:48px 0}.visual{min-height:0}.grid{grid-template-columns:1fr}.cta{align-items:flex-start;flex-direction:column}.photo{height:260px}section.content{padding:52px 0}}
</style>
</head>
