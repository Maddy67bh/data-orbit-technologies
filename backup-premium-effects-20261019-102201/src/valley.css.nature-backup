.sv-experience {
  --sv-cream: #f5f0e6;
  --sv-gold: #d6bd91;
  position: relative;
  isolation: isolate;
  min-height: 720px;
  height: min(860px, 92vh);
  overflow: hidden;
  background: #142d27;
  color: var(--sv-cream);
  font-family: inherit;
}

.sv-photo,
.sv-grain,
.sv-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.sv-photo {
  z-index: -3;
  background-image: url("https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=2400&q=90");
  background-position: center 52%;
  background-size: cover;
  transform: scale(1.035);
  animation: sv-reveal 1.4s ease-out both, sv-drift 24s ease-in-out infinite alternate;
  transition: filter 1.2s ease;
}

.sv-night .sv-photo {
  filter: brightness(.43) saturate(.7) hue-rotate(12deg);
}

.sv-grain {
  z-index: -2;
  opacity: .16;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.25'/%3E%3C/svg%3E");
}

.sv-vignette {
  z-index: -1;
  background:
    linear-gradient(90deg, rgba(8,22,19,.88) 0%, rgba(8,22,19,.67) 31%, rgba(8,22,19,.16) 72%, rgba(8,22,19,.05) 100%),
    linear-gradient(0deg, rgba(7,18,16,.72) 0%, transparent 25%, transparent 75%, rgba(7,18,16,.28) 100%);
  transition: background 1s ease;
}

.sv-night .sv-vignette {
  background:
    linear-gradient(90deg, rgba(4,14,18,.92), rgba(4,14,18,.66) 38%, rgba(4,14,18,.2)),
    linear-gradient(0deg, rgba(4,12,16,.82), transparent 50%, rgba(4,12,16,.35));
}

.sv-topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30px clamp(22px, 5.3vw, 82px);
  border-bottom: 1px solid rgba(245,240,230,.18);
}

.sv-brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.sv-brand-mark {
  font-family: Georgia, serif;
  font-size: 27px;
  letter-spacing: -.09em;
}

.sv-brand-mark span { color: var(--sv-gold); }

.sv-brand-label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .17em;
}

.sv-brand-label i {
  color: rgba(245,240,230,.64);
  font-size: 8px;
  font-style: normal;
  font-weight: 400;
  letter-spacing: .2em;
}

.sv-edition {
  color: rgba(245,240,230,.75);
  font-size: 9px;
  letter-spacing: .19em;
}

.sv-content {
  position: absolute;
  top: 48%;
  left: clamp(24px, 10.5vw, 160px);
  width: min(570px, 76%);
  transform: translateY(-43%);
  animation: sv-copy-in 1s .12s both;
}

.sv-kicker {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #e4d2ae;
  font-size: 9px;
  letter-spacing: .23em;
  font-weight: 600;
}

.sv-live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #d8c09a;
  box-shadow: 0 0 0 4px rgba(216,192,154,.14);
}

.sv-content h2 {
  margin: 27px 0 23px;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
  font-size: clamp(60px, 7.4vw, 106px);
  letter-spacing: -.075em;
  line-height: .91;
  text-wrap: balance;
}

.sv-content h2 em {
  color: #e3c9a1;
  font-weight: 400;
}

.sv-description {
  max-width: 365px;
  margin: 0;
  color: rgba(250,246,237,.78);
  font-size: 14px;
  line-height: 1.95;
  letter-spacing: .015em;
}

.sv-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 22px;
  margin-top: 32px;
}

.sv-primary {
  display: inline-flex;
  align-items: center;
  gap: 28px;
  min-height: 51px;
  padding: 0 10px 0 21px;
  border: 1px solid rgba(238,223,195,.8);
  border-radius: 2px;
  background: #e9dfca;
  color: #20372e;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .025em;
  cursor: pointer;
  transition: background .25s, color .25s, transform .25s;
}

.sv-primary:hover {
  background: #fff8e9;
  transform: translateY(-2px);
}

.sv-arrow {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border: 1px solid rgba(32,55,46,.22);
  font-size: 17px;
}

.sv-duration {
  color: rgba(245,240,230,.7);
  font-size: 8px;
  letter-spacing: .15em;
}

.sv-bottom {
  position: absolute;
  right: clamp(22px, 5.3vw, 82px);
  bottom: 28px;
  left: clamp(22px, 5.3vw, 82px);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  padding-top: 22px;
  border-top: 1px solid rgba(245,240,230,.24);
}

.sv-location {
  display: flex;
  align-items: center;
  gap: 13px;
}

.sv-location-icon {
  display: grid;
  place-items: center;
  width: 35px;
  height: 35px;
  border: 1px solid rgba(245,240,230,.4);
  border-radius: 50%;
  color: var(--sv-gold);
  font-size: 21px;
}

.sv-location b,
.sv-location small {
  display: block;
  font-size: 9px;
  letter-spacing: .13em;
}

.sv-location b { font-weight: 500; }
.sv-location small {
  margin-top: 6px;
  color: rgba(245,240,230,.62);
  font-size: 8px;
  letter-spacing: .16em;
}

.sv-scroll {
  display: flex;
  align-items: center;
  gap: 12px;
  color: rgba(245,240,230,.68);
  font-size: 8px;
  letter-spacing: .18em;
}

.sv-scroll i {
  display: block;
  width: 40px;
  height: 1px;
  background: var(--sv-gold);
  transform-origin: left;
  animation: sv-line 2s ease-in-out infinite;
}

.sv-index {
  font-family: Georgia, serif;
  font-size: 19px;
  color: var(--sv-cream);
}

.sv-index span {
  padding: 0 4px;
  color: rgba(245,240,230,.48);
  font-size: 12px;
}

.sv-orbit {
  position: absolute;
  z-index: -1;
  width: 430px;
  height: 430px;
  right: -110px;
  top: 15%;
  border: 1px solid rgba(239,223,194,.15);
  border-radius: 50%;
  pointer-events: none;
}

.sv-orbit-two {
  width: 520px;
  height: 520px;
  right: -155px;
  top: 9%;
  border-color: rgba(239,223,194,.08);
}

.sv-petals {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.sv-petals span {
  position: absolute;
  top: -15%;
  left: var(--x);
  width: 5px;
  height: 9px;
  border-radius: 80% 10% 80% 10%;
  background: rgba(242,205,204,.75);
  animation: sv-petal-fall var(--duration) var(--delay) linear infinite;
  opacity: .0;
}

.sv-night .sv-petals span { background: rgba(223,188,215,.6); }

@keyframes sv-reveal {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes sv-drift {
  from { transform: scale(1.035) translate3d(0,0,0); }
  to { transform: scale(1.09) translate3d(-.5%, .3%, 0); }
}
@keyframes sv-copy-in {
  from { opacity: 0; translate: 0 15px; }
  to { opacity: 1; translate: 0 0; }
}
@keyframes sv-line {
  0%, 100% { transform: scaleX(.45); opacity: .5; }
  50% { transform: scaleX(1); opacity: 1; }
}
@keyframes sv-petal-fall {
  0% { transform: translate3d(0,-5vh,0) rotate(0); opacity: 0; }
  12% { opacity: .65; }
  80% { opacity: .6; }
  100% { transform: translate3d(-70px,115vh,0) rotate(500deg); opacity: 0; }
}

@media (max-width: 700px) {
  .sv-experience { min-height: 700px; height: 88svh; }
  .sv-photo { background-position: 59% center; }
  .sv-vignette {
    background: linear-gradient(90deg, rgba(7,20,17,.78), rgba(7,20,17,.27)),
                linear-gradient(0deg, rgba(7,20,17,.72), transparent 52%, rgba(7,20,17,.2));
  }
  .sv-topbar { padding: 22px 20px; }
  .sv-edition { max-width: 100px; text-align: right; font-size: 8px; line-height: 1.7; }
  .sv-content { top: 46%; left: 24px; width: calc(100% - 48px); }
  .sv-content h2 { font-size: clamp(57px, 13vw, 82px); }
  .sv-description { max-width: 310px; font-size: 13px; }
  .sv-bottom { left: 20px; right: 20px; bottom: 22px; }
  .sv-scroll { display: none; }
  .sv-duration { max-width: 100px; line-height: 1.7; }
  .sv-orbit { right: -300px; }
}

@media (prefers-reduced-motion: reduce) {
  .sv-photo, .sv-content, .sv-scroll i, .sv-petals span {
    animation: none !important;
  }
}
