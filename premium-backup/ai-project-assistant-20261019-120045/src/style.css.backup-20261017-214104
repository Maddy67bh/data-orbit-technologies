@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{font-family:Manrope,sans-serif;color:#eff7f0;background:#07100d;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;--green:#77edaa;--muted:#9bafa1;--line:rgba(187,228,201,.14);--mono:'DM Mono',monospace}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px;background:#07100d}body{margin:0;min-width:320px;background:transparent}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}button,a{-webkit-tap-highlight-color:transparent}::selection{background:var(--green);color:#041009}
#water{position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
.header{height:80px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(5,14,10,.72);backdrop-filter:blur(20px);position:relative;z-index:20}.brand{display:flex;align-items:center;gap:11px;font-size:12px;font-weight:800;letter-spacing:1.1px}.brand b{color:var(--green);font-weight:600}.logo{width:30px;height:30px;border:1px solid var(--green);border-radius:50%;display:grid;place-items:center;color:var(--green);font-size:21px}.nav{display:flex;align-items:center;gap:32px}.nav>a{font-size:12px;color:#c1cec5}.nav>a:hover{color:var(--green)}.nav .nav-cta{display:flex;align-items:center;gap:8px;padding:11px 15px;border:1px solid #47795a;border-radius:4px;color:var(--green)}.menu-btn{display:none;background:transparent;border:0;color:white}
.hero{min-height:660px;padding:70px 10% 85px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:2%;position:relative;overflow:hidden}.hero:before{content:"";position:absolute;right:-100px;top:20px;width:550px;height:550px;border-radius:50%;background:radial-gradient(circle,rgba(20,139,79,.2),transparent 70%);pointer-events:none}.hero-copy{position:relative;z-index:3}.eyebrow{font:10px var(--mono);letter-spacing:1.5px;color:#a9bcaf;display:flex;align-items:center;gap:9px}.eyebrow i{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green)}h1{font-size:clamp(48px,6.2vw,82px);font-weight:600;line-height:1.07;letter-spacing:-4.5px;margin:26px 0 22px}h1 span,h2 span{color:var(--green)}.lead{max-width:470px;font-size:13px;color:#adbbb1;line-height:2}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:11px;min-height:46px;padding:0 16px;border:1px solid transparent;border-radius:4px;font-size:11px;font-weight:800;cursor:pointer;transition:.25s}.btn:hover{transform:translateY(-2px)}.primary{background:var(--green);color:#06120b}.primary:hover{background:#a0f5c0}.secondary{border-color:var(--line);color:#d5e1d8}.secondary:hover{border-color:var(--green)}.footnote{margin-top:53px;display:flex;align-items:center;gap:10px;font:9px var(--mono);letter-spacing:1px;color:#81998a}.footnote i{width:24px;height:1px;background:var(--green)}
.orb-scene{width:min(100%,440px);aspect-ratio:1;position:relative;margin:auto;display:grid;place-items:center;perspective:800px}.orb-halo{position:absolute;width:70%;height:70%;border-radius:50%;background:#158b4c3d;filter:blur(60px);animation:halo 6s ease-in-out infinite alternate}.orb{position:relative;width:46%;aspect-ratio:1;border-radius:50%;overflow:hidden;background:radial-gradient(circle at 30% 25%,#e9fff06b,#3dbe7a24 24%,#07532c8c 51%,#010e09 76%);border:1px solid #a5ffc9a6;box-shadow:inset -20px -20px 42px #0009,inset 12px 12px 25px #c5ffda25,0 0 55px #27cd7838;animation:float 7s ease-in-out infinite}.orb-light{position:absolute;top:13%;left:17%;width:37%;height:14%;border-radius:50%;transform:rotate(-35deg);background:#e7fff0b5;filter:blur(8px)}.orb-inner{position:absolute;inset:25%;border-radius:50%;background:radial-gradient(circle at 35% 30%,#7dffb3cc,#149f5766 40%,transparent 75%);box-shadow:0 0 35px #42ff9940}.orb-wave{position:absolute;top:42%;left:-5%;width:110%;height:25%;border-radius:50%;border-top:1px solid #d0ffe2b8;border-bottom:1px solid #43eb977d;transform:rotate(-23deg)}.orbit{position:absolute;width:80%;height:31%;border:1px solid #70eaa95e;border-radius:50%;transform:rotate(-33deg);animation:orbit 18s linear infinite}.orbit i{position:absolute;left:14%;top:6%;width:6px;height:6px;background:#a5ffc8;border-radius:50%;box-shadow:0 0 15px #50e98e}.o2{width:88%;height:48%;transform:rotate(55deg);border-color:#a7ffc938;animation-duration:25s;animation-direction:reverse}.o2 i{left:83%;top:76%}.o3{width:65%;height:87%;transform:rotate(65deg);border-color:#3cc37c38;animation-duration:30s}.o3 i{left:28%;top:92%;width:4px;height:4px}.orb-label{position:absolute;bottom:7%;font:9px var(--mono);letter-spacing:2px;color:#abc6b4;white-space:nowrap}
@keyframes float{0%,100%{transform:translateY(0) rotateX(-12deg) rotateY(15deg)}50%{transform:translateY(-12px) rotateX(-6deg) rotateY(23deg)}}@keyframes orbit{to{rotate:360deg}}@keyframes halo{to{opacity:.6;transform:scale(1.12)}}
.birds{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1;opacity:.48}.bird{position:absolute;width:19px;fill:#d5e7d9;animation:fly 20s linear infinite}.bird0{top:16%;left:-5%}.bird1{top:25%;left:-5%;width:12px;animation-delay:-7s;animation-duration:26s}.bird2{top:12%;left:-5%;width:15px;animation-delay:-14s;animation-duration:29s}.bird3{top:33%;left:-5%;width:12px;animation-delay:-9s;animation-duration:23s}.bird4{top:20%;left:-5%;width:10px;animation-delay:-19s;animation-duration:30s}.bird5{top:28%;left:-5%;width:16px;animation-delay:-12s;animation-duration:25s}@keyframes fly{0%{transform:translateX(-5vw) translateY(0)}30%{transform:translateX(35vw) translateY(-14px)}65%{transform:translateX(75vw) translateY(9px)}100%{transform:translateX(115vw) translateY(-8px)}}
.scroll-note{position:absolute;left:3.5%;bottom:30px;color:#82988a;font:9px var(--mono);letter-spacing:1px}.strip{min-height:65px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;justify-content:center;align-items:center;gap:clamp(15px,5vw,65px);flex-wrap:wrap;padding:18px 5%;font:9px var(--mono);letter-spacing:1.1px;color:#a1b3a6;background:#06100bd9}.strip i{width:4px;height:4px;background:var(--green);border-radius:50%}
.section{padding:105px 10%}.section-head{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:42px}.section-head h2,.about h2,.contact h2{font-size:clamp(38px,4.4vw,56px);font-weight:600;line-height:1.15;letter-spacing:-2.5px;margin:20px 0 0}.section-head>p{max-width:380px;color:var(--muted);font-size:12px;line-height:2;margin:0 0 4px}.service-grid,.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.glass{background:linear-gradient(140deg,#172c21c7,#09160fb8);border:1px solid var(--line);backdrop-filter:blur(18px)}.service{padding:25px 23px;min-height:280px;display:flex;flex-direction:column;transition:transform .25s,border-color .25s}.service:hover{transform:translateY(-5px);border-color:#77edaa66}.service-top{display:flex;justify-content:space-between;color:var(--green)}.service-top>span{font:10px var(--mono);color:#839c8b}.service h3{font-size:17px;margin:28px 0 12px}.service>p,.project>p{font-size:11px;color:var(--muted);line-height:1.95}.tags{font:9px var(--mono);color:#b8cdbd;margin-top:auto}.text-link{display:inline-flex;align-items:center;gap:8px;color:var(--green);font-size:11px;margin-top:22px}.text-link svg{transition:transform .2s}.text-link:hover svg{transform:translateX(4px)}
.work{padding-top:45px}.project{min-width:0;border-bottom:1px solid var(--line);padding-bottom:25px}.project-art{height:205px;margin-bottom:22px;border:1px solid var(--line);background:radial-gradient(ellipse at center,#1e844a38,#08150ed9 72%);display:grid;place-items:center;overflow:hidden;position:relative}.project-art:after{content:"";position:absolute;inset:0;background:linear-gradient(135deg,#70e7a10d,transparent 60%);pointer-events:none}.dashboard{width:82%;padding:14px;background:#09170fd9;border:1px solid #6ee7a633}.dashboard small{display:flex;justify-content:space-between;font:8px var(--mono);color:#b9cbbf}.dashboard small b{color:var(--green)}.bars{height:88px;display:flex;align-items:end;gap:6px;margin:15px 0 10px;border-bottom:1px solid var(--line)}.bars i{flex:1;background:linear-gradient(0deg,#147547,#73edaa);border-radius:2px 2px 0 0}.network{width:140px;height:140px;position:relative;border:1px solid #69e59d45;border-radius:50%;display:grid;place-items:center;color:var(--green)}.network:before,.network:after{content:"";position:absolute;inset:18px;border:1px solid #69e59d35;border-radius:50%;transform:scaleX(.5) rotate(45deg)}.network:after{transform:scaleX(.5) rotate(-45deg)}.network>i{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--green);left:calc(50% + cos(var(--i)*45deg)*62px);top:calc(50% + sin(var(--i)*45deg)*62px)}.code-window{font:11px var(--mono);border-left:1px solid var(--green);padding:10px 20px;color:#a8bbae}.code-window small{color:#728e7c;font-size:9px}.code-window b{color:var(--green)}.code-window i{display:block;width:7px;height:12px;background:var(--green);animation:blink 1s step-end infinite}@keyframes blink{50%{opacity:0}}.project-meta{display:flex;justify-content:space-between;gap:6px;font:8px var(--mono);letter-spacing:.7px;color:var(--green)}.project-meta span{color:#829889}.project h3{font-size:16px;margin:13px 0 10px}.project>p{min-height:62px;margin-bottom:0}
.about{padding:85px 13%;display:flex;align-items:center;justify-content:center;gap:10%;background:linear-gradient(100deg,#08170ed9,#0b2416d9,#05110bd9);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.about-mark{width:210px;height:210px;flex:0 0 auto;position:relative;border:1px solid #6ee7a638;border-radius:50%;display:grid;place-items:center;color:var(--green);font:25px var(--mono)}.about-mark:before{content:"";position:absolute;inset:25px;border:1px solid #6ee7a638;border-radius:50%}.about-mark:after{content:"";position:absolute;inset:-10px 43px;border:1px solid #6ee7a638;border-radius:50%;transform:rotate(48deg)}.about-mark i{position:absolute;inset:0;border:1px solid #6ee7a638;border-radius:50%;transform:rotate(60deg) scaleX(.55)}.about-mark i:nth-of-type(2){transform:rotate(-60deg) scaleX(.55)}.about-mark i:nth-of-type(3){transform:rotate(90deg) scaleX(.55)}.about>div:last-child{max-width:520px}.about p,.contact>div>p{font-size:12px;line-height:2;color:var(--muted);margin:22px 0 0}.contact{display:grid;grid-template-columns:.9fr 1.1fr;gap:10%;align-items:start}.contact h2{margin-bottom:22px}.contact-note{display:flex;align-items:center;gap:10px;color:#b0c9b7;font-size:11px;margin-top:32px}.contact-note svg{color:var(--green)}.contact-form{padding:27px;display:flex;flex-direction:column;gap:17px}.contact-form label{display:flex;flex-direction:column;gap:8px;font-size:11px;color:#d4e1d7}.contact-form input,.contact-form textarea{width:100%;border:1px solid #b6e0c429;background:#030d0878;border-radius:3px;padding:13px;color:#f0fff4;outline:none;font-size:12px;resize:vertical}.contact-form input:focus,.contact-form textarea:focus{border-color:#6ee7a6a6}.contact-form input::placeholder,.contact-form textarea::placeholder{color:#718778}.contact-form .btn{align-self:start}.notice{font-size:11px;color:#c4e8d0;line-height:1.7;margin:0}.legal{font:9px var(--mono);color:#819687}footer{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:26px 7%;border-top:1px solid var(--line);background:#040c0880}footer p,footer small{font-size:10px;color:#879b8d;margin:0}footer small{font-family:var(--mono)}
@media(max-width:900px){.hero{padding-left:6%;padding-right:6%}.section{padding-left:6%;padding-right:6%}.service{padding:22px 16px}.about{padding:70px 7%}}
@media(max-width:680px){.header{height:70px;padding:0 5%}.brand{font-size:10px;letter-spacing:.5px;gap:7px}.logo{width:26px;height:26px}.menu-btn{display:inline-flex;color:white;padding:8px}.nav{display:none;position:absolute;top:69px;left:0;right:0;padding:16px 6% 22px;background:#06100bf7;border-bottom:1px solid var(--line);flex-direction:column;align-items:stretch;gap:0}.nav.open{display:flex}.nav>a{padding:14px 0}.nav .nav-cta{justify-content:center;margin-top:8px}.hero{display:flex;flex-direction:column;align-items:stretch;gap:0;padding:75px 6% 70px;min-height:auto}h1{font-size:clamp(47px,12vw,66px);letter-spacing:-3px}.lead{font-size:12px}.actions{gap:8px}.btn{padding:0 12px;font-size:10px}.footnote{margin-top:32px}.hero-art{width:100%;max-width:355px;margin:0 auto}.orb-label{font-size:8px}.scroll-note{left:6%;bottom:20px;font-size:8px}.strip{gap:13px;font-size:8px}.strip i{display:none}.section{padding-top:76px;padding-bottom:76px}.section-head{display:block;margin-bottom:30px}.section-head h2,.about h2,.contact h2{font-size:39px;letter-spacing:-1.8px}.section-head>p{margin-top:18px}.service-grid,.project-grid{grid-template-columns:1fr;gap:14px}.service{min-height:245px;padding:22px}.service h3{margin-top:22px}.project-art{height:215px}.project>p{min-height:0}.about{padding:60px 6%;flex-direction:column;align-items:flex-start;gap:35px}.about-mark{width:150px;height:150px;align-self:center}.contact{grid-template-columns:1fr;gap:28px}.contact-form{padding:20px}footer{padding:24px 6%;flex-wrap:wrap}footer p{order:3;width:100%}footer small{font-size:9px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;scroll-behavior:auto!important;transition:none!important}}
