/* ===== PREMIUM SAKURA HERO EFFECT ===== */

.sakura-layer {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}

.hero > .sakura-layer {
  z-index: 1;
}

.hero > .hero-content,
.hero > .hero-bottom {
  position: relative;
  z-index: 2;
}

.sakura-glow {
  position: absolute;
  width: 360px;
  height: 360px;
  right: 8%;
  top: 8%;
  border-radius: 50%;
  background: rgba(224, 155, 181, 0.12);
  filter: blur(75px);
  animation: sakuraGlow 7s ease-in-out infinite alternate;
}

.sakura-branch {
  position: absolute;
  font-size: clamp(100px, 18vw, 230px);
  opacity: 0.5;
  filter: drop-shadow(0 0 22px rgba(239, 175, 196, 0.22));
  animation: sakuraSway 7s ease-in-out infinite alternate;
}

.sakura-branch-one {
  top: -45px;
  right: -20px;
}

.sakura-branch-two {
  right: 20%;
  bottom: -90px;
  font-size: clamp(70px, 12vw, 150px);
  opacity: 0.25;
  animation-delay: -3s;
}

.sakura-petal {
  position: absolute;
  top: -25px;
  display: block;
  border-radius: 70% 15% 65% 35%;
  background: linear-gradient(135deg, #fff0f5, #efb1c7 65%, #c87998);
  box-shadow: 0 0 10px rgba(240, 173, 197, 0.25);
  opacity: 0;
  animation-name: sakuraFall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes sakuraFall {
  0% {
    transform: translate3d(0, -5vh, 0) rotate(0deg);
    opacity: 0;
  }
  10% { opacity: 0.85; }
  50% {
    transform: translate3d(45px, 50vh, 0) rotate(190deg);
  }
  90% { opacity: 0.65; }
  100% {
    transform: translate3d(-30px, 110vh, 0) rotate(380deg);
    opacity: 0;
  }
}

@keyframes sakuraSway {
  from { translate: 0 0; }
  to { translate: -12px 10px; }
}

@keyframes sakuraGlow {
  from { opacity: 0.5; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1.1); }
}

@media (max-width: 600px) {
  .sakura-branch-one {
    right: -45px;
    opacity: 0.3;
  }
  .sakura-branch-two {
    right: 2%;
    bottom: -35px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sakura-petal,
  .sakura-branch,
  .sakura-glow {
    animation: none;
  }
  .sakura-petal {
    display: none;
  }
}


/* ===== REPLACE GREEN ORBIT WITH SAKURA FLORAL VISUAL ===== */
.hero [class*="orbit" i],
.hero [class*="orbital" i],
.hero [class*="circle-model" i] {
  display: none !important;
}

.hero {
  position: relative;
  isolation: isolate;
}

.hero::after {
  content: "🌸";
  position: absolute;
  z-index: 0;
  right: 7%;
  top: 50%;
  transform: translateY(-50%);
  font-size: clamp(150px, 23vw, 310px);
  line-height: 1;
  opacity: 0.22;
  filter: drop-shadow(0 18px 35px rgba(196, 113, 145, 0.18));
  pointer-events: none;
  animation: sakuraFloat 6s ease-in-out infinite alternate;
}

.hero > .sakura-layer {
  z-index: 1;
}

.hero > *:not(.sakura-layer) {
  position: relative;
  z-index: 2;
}

@keyframes sakuraFloat {
  from { transform: translateY(-48%) rotate(-5deg); }
  to { transform: translateY(-53%) rotate(5deg); }
}

@media (max-width: 700px) {
  .hero::after {
    right: 0;
    top: 65%;
    font-size: 150px;
    opacity: 0.12;
  }
}

