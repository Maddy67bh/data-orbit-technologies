.site-shell {
  --green: #10271d;
  --green-light: #19392a;
  --gold: #dfc18a;
  --ivory: #f5f0e5;
  --muted: #bfc9bc;
  overflow: hidden;
  color: var(--ivory);
  background: var(--green);
}

.site-shell * {
  box-sizing: border-box;
}

.section-pad {
  padding: 110px 8%;
}

.hero {
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  min-height: 760px;
  min-height: 100svh;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 72% 30%, #416349, transparent 45%),
    linear-gradient(135deg, #10271d, #294a35);
}

.hero-image {
  position: absolute;
  z-index: -3;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 50%;
  animation: image-reveal 1.8s ease-out both;
}

.hero-shade {
  position: absolute;
  z-index: -2;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(6, 23, 16, .88) 0%, rgba(8, 28, 19, .66) 42%, rgba(8, 27, 20, .22) 100%),
    linear-gradient(0deg, rgba(6, 22, 16, .74) 0%, transparent 40%, rgba(6, 22, 16, .28) 100%);
}

.hero-grain {
  position: absolute;
  z-index: -1;
  inset: 0;
  pointer-events: none;
  opacity: .11;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.23'/%3E%3C/svg%3E");
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 24px 7%;
  border-bottom: 1px solid rgba(245, 229, 197, .2);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--ivory);
  text-decoration: none;
  flex-shrink: 0;
}

.orbit-mark {
  width: 43px;
  height: 43px;
  fill: none;
  stroke: var(--gold);
  stroke-width: 1.35;
  flex-shrink: 0;
}

.orbit-mark-dot {
  fill: var(--gold);
  stroke: none;
}

.brand-copy strong {
  display: block;
  font-size: 13px;
  letter-spacing: 2.3px;
}

.brand-copy small {
  display: block;
  margin-top: 5px;
  color: var(--gold);
  font-size: 8px;
  letter-spacing: 3.1px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: clamp(15px, 2.4vw, 34px);
}

.nav-links a {
  color: #f4eddf;
  font-size: 11px;
  text-decoration: none;
  transition: color .2s ease;
}

.nav-links a:hover {
  color: var(--gold);
}

.nav-links .nav-contact {
  padding: 13px 16px;
  border: 1px solid rgba(223, 193, 138, .75);
}

.nav-contact span {
  margin-left: 10px;
  color: var(--gold);
}

.menu-toggle {
  display: none;
  padding: 9px;
  border: 1px solid rgba(223, 193, 138, .6);
  background: transparent;
  cursor: pointer;
}

.menu-toggle span {
  display: block;
  width: 22px;
  height: 1px;
  margin: 5px 0;
  background: var(--gold);
}

.hero-layout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  padding: 90px 9% 110px;
}

.hero-copy {
  max-width: 820px;
  animation: content-reveal .9s .15s ease both;
}

.eyebrow, .section-kicker {
  display: flex;
  align-items: center;
  gap: 11px;
  color: var(--gold);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 3px;
}

.eyebrow-rule {
  width: 30px;
  height: 1px;
  background: var(--gold);
}

.hero h1 {
  margin: 28px 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(52px, 7.5vw, 100px);
  font-weight: 400;
  line-height: 1.03;
  letter-spacing: -2.5px;
}

.hero h1 em, .intro h2 em, .section-heading h2 em,
.approach-copy h2 em, .contact-inner h2 em {
  color: var(--gold);
  font-weight: 400;
}

.hero-description {
  max-width: 475px;
  color: rgba(250, 246, 236, .82);
  font-size: 15px;
  line-height: 1.95;
}

.hero-buttons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 27px;
  margin-top: 34px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  padding: 17px 21px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.15px;
  text-decoration: none;
  transition: transform .25s ease, background .25s ease;
}

.button-gold {
  color: #152c20;
  background: var(--gold);
}

.button-gold:hover {
  transform: translateY(-3px);
  background: #f0d7a4;
}

.button span {
  font-size: 16px;
}

.button-text {
  color: var(--ivory);
  font-size: 12px;
  text-decoration: none;
}

.button-text span {
  padding-left: 7px;
  color: var(--gold);
}

.hero-stamp {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  margin-left: 30px;
  padding: 27px 18px;
  border: 1px solid rgba(232, 204, 155, .5);
  color: #f4e6cb;
  font-size: 9px;
  letter-spacing: 2.5px;
  transform: rotate(7deg);
}

.stamp-orbit {
  color: var(--gold);
  font-size: 30px;
}

.hero-stamp .stamp-small {
  color: var(--gold);
  font-size: 7px;
  letter-spacing: 1.8px;
}

.hero-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 7%;
  border-top: 1px solid rgba(245, 229, 197, .2);
  color: rgba(246, 237, 219, .8);
  font-size: 9px;
  letter-spacing: 1.6px;
}

.hero-bottom a {
  color: var(--gold);
  text-decoration: none;
}

.intro {
  background: #f2eee3;
  color: #183327;
}

.intro .section-kicker, .services .section-kicker,
.work-section .section-kicker {
  color: #5c775f;
}

.gold-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 0 4px rgba(223, 193, 138, .12);
}

.intro-grid {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 70px;
  align-items: start;
  margin-top: 34px;
}

.intro h2, .section-heading h2, .approach-copy h2,
.contact-inner h2 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(38px, 5vw, 65px);
  font-weight: 400;
  line-height: 1.12;
  letter-spacing: -1.2px;
}

.intro h2 em {
  color: #718567;
}

.intro-copy p {
  margin: 0 0 18px;
  color: #526358;
  font-size: 14px;
  line-height: 1.95;
}

.underlined-link {
  display: inline-flex;
  gap: 20px;
  align-items: center;
  margin-top: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid #b39b69;
  color: #1d3829;
  font-size: 11px;
  text-decoration: none;
}

.underlined-link span {
  color: #927641;
}

.principles {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 80px;
  padding-top: 25px;
  border-top: 1px solid #d6d1c5;
}

.principles div {
  display: flex;
  align-items: center;
  gap: 15px;
}

.principles span {
  color: #9c8555;
  font-size: 10px;
}

.principles strong {
  font-size: 12px;
  font-weight: 500;
}

.services, .work-section {
  background: #122a20;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 45px;
  margin-bottom: 45px;
}

.section-heading h2 {
  margin-top: 23px;
  color: var(--ivory);
}

.section-heading > p {
  max-width: 355px;
  margin: 0 0 5px;
  color: #bdc8bd;
  font-size: 13px;
  line-height: 1.9;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.service-card {
  display: flex;
  flex-direction: column;
  min-height: 345px;
  padding: 26px;
  border: 1px solid rgba(223, 193, 138, .22);
  background: linear-gradient(145deg, rgba(255,255,255,.035), rgba(255,255,255,.008));
  transition: border-color .25s ease, transform .25s ease, background .25s ease;
}

.service-card:hover {
  transform: translateY(-5px);
  border-color: rgba(223, 193, 138, .65);
  background: rgba(255,255,255,.045);
}

.card-topline {
  display: flex;
  justify-content: space-between;
  color: var(--gold);
  font-size: 10px;
}

.card-arrow {
  font-size: 17px;
}

.service-symbol {
  margin-top: 26px;
  color: var(--gold);
  font-family: Georgia, serif;
  font-size: 36px;
}

.card-tag {
  margin: 18px 0 0;
  color: #b5c3ad;
  font-size: 8px;
  letter-spacing: 2px;
}

.service-card h3, .project-info h3 {
  margin: 12px 0;
  color: #f7f0e3;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24px;
  font-weight: 400;
}

.card-description {
  color: #b9c5b9;
  font-size: 12px;
  line-height: 1.9;
}

.card-link {
  display: flex;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 25px;
  color: var(--gold);
  font-size: 10px;
  text-decoration: none;
}

.approach {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 85px;
  background: #193629;
}

.approach-visual {
  position: relative;
  display: grid;
  place-items: center;
  width: min(100%, 450px);
  aspect-ratio: 1;
  margin: auto;
  border: 1px solid rgba(223, 193, 138, .2);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(223,193,138,.08), transparent 66%);
}

.approach-orbit {
  position: absolute;
  border: 1px solid rgba(223, 193, 138, .32);
  border-radius: 50%;
}

.orbit-one {
  width: 72%;
  height: 72%;
  transform: rotate(-35deg) scaleY(.55);
}

.orbit-two {
  width: 92%;
  height: 44%;
  transform: rotate(35deg);
}

.approach-core {
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
}

.approach-core .orbit-mark {
  width: 58px;
  height: 58px;
}

.approach-core > span {
  font-size: 10px;
  letter-spacing: 3px;
}

.approach-core small {
  color: var(--gold);
  font-size: 8px;
  letter-spacing: 2px;
}

.visual-label {
  position: absolute;
  padding: 8px 10px;
  border: 1px solid rgba(223,193,138,.4);
  background: #193629;
  color: #ead8b6;
  font-size: 8px;
  letter-spacing: 1.5px;
}

.visual-label-one { top: 17%; left: 8%; }
.visual-label-two { top: 27%; right: 2%; }
.visual-label-three { bottom: 15%; left: 23%; }

.approach-copy h2 {
  margin-top: 25px;
  font-size: clamp(38px, 4.2vw, 58px);
}

.approach-copy > p {
  margin: 23px 0;
  color: #c2cec2;
  font-size: 13px;
  line-height: 1.95;
}

.approach-list {
  border-top: 1px solid rgba(223,193,138,.25);
}

.approach-list div {
  display: flex;
  align-items: baseline;
  gap: 18px;
  padding: 13px 0;
  border-bottom: 1px solid rgba(223,193,138,.18);
}

.approach-list span {
  color: var(--gold);
  font-size: 10px;
}

.approach-list p {
  margin: 0;
  color: #c2cec2;
  font-size: 11px;
}

.approach-list strong {
  color: #f7f0e3;
  font-weight: 600;
}

.work-section {
  background: #10271d;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.project-card {
  min-width: 0;
}

.project-art {
  position: relative;
  display: grid;
  place-items: center;
  overflow: hidden;
  aspect-ratio: 1.12;
  background: linear-gradient(135deg, #274b37, #101e18);
}

.project-art-02 {
  background: linear-gradient(145deg, #30473b, #15291f 70%);
}

.project-art-03 {
  background: linear-gradient(135deg, #4a5540, #182b21);
}

.project-index {
  position: absolute;
  top: 18px;
  left: 18px;
  color: rgba(248, 241, 229, .7);
  font-size: 10px;
  letter-spacing: 2px;
}

.art-orbit {
  position: absolute;
  width: 62%;
  height: 62%;
  border: 1px solid rgba(223,193,138,.55);
  border-radius: 50%;
}

.art-orbit-a {
  transform: rotate(40deg) scaleY(.4);
}

.art-orbit-b {
  transform: rotate(-40deg) scaleY(.4);
}

.art-center {
  z-index: 1;
  display: grid;
  place-items: center;
  width: 68px;
  height: 68px;
  border: 1px solid rgba(223,193,138,.8);
  border-radius: 50%;
  color: var(--gold);
  font-family: Georgia, serif;
  font-size: 30px;
  box-shadow: 0 0 55px rgba(223,193,138,.12);
}

.art-caption {
  position: absolute;
  right: 15px;
  bottom: 15px;
  color: rgba(248,241,229,.6);
  font-size: 7px;
  letter-spacing: 1.5px;
}

.project-info {
  padding: 19px 2px;
}

.project-info > p {
  color: var(--gold);
  font-size: 8px;
  letter-spacing: 2px;
}

.project-info h3 {
  font-size: 23px;
}

.project-info > span {
  display: block;
  color: #b9c5b9;
  font-size: 12px;
  line-height: 1.8;
}

.portfolio-note {
  margin-top: 25px;
  color: #8fa093;
  font-size: 10px;
}

.contact-section {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: 100px 8%;
  background:
    radial-gradient(ellipse at 85% 40%, rgba(84,111,75,.4), transparent 40%),
    linear-gradient(120deg, #203e2e, #10271d);
}

.contact-inner {
  position: relative;
  z-index: 1;
  max-width: 720px;
}

.contact-inner h2 {
  margin-top: 27px;
  font-size: clamp(52px, 7vw, 88px);
}

.contact-inner > p:not(.section-kicker) {
  max-width: 480px;
  color: #d0d8cd;
  font-size: 14px;
  line-height: 1.9;
}

.contact-inner .button {
  margin-top: 20px;
}

.contact-note {
  display: block;
  margin-top: 15px;
  color: #b8c6b8;
  font-size: 10px;
}

.contact-decoration {
  position: absolute;
  top: 50%;
  right: 8%;
  display: grid;
  place-items: center;
  width: 280px;
  height: 280px;
  border: 1px solid rgba(223,193,138,.2);
  border-radius: 50%;
  transform: translateY(-50%);
}

.contact-decoration::before,
.contact-decoration::after {
  position: absolute;
  width: 210px;
  height: 90px;
  border: 1px solid rgba(223,193,138,.3);
  border-radius: 50%;
  content: "";
  transform: rotate(45deg);
}

.contact-decoration::after {
  transform: rotate(-45deg);
}

.contact-decoration .orbit-mark {
  width: 72px;
  height: 72px;
}

.site-footer {
  display: grid;
  grid-template-columns: 1fr 1.2fr auto;
  align-items: center;
  gap: 25px;
  padding: 30px 7%;
  background: #0b1c14;
}

.footer-brand .orbit-mark {
  width: 35px;
  height: 35px;
}

.footer-brand .brand-copy strong {
  font-size: 11px;
}

.footer-brand .brand-copy small {
  font-size: 7px;
}

.site-footer > p {
  color: #b9c5b9;
  font-size: 11px;
}

.back-top {
  color: var(--gold);
  font-size: 9px;
  letter-spacing: 1.5px;
  text-decoration: none;
}

.copyright {
  grid-column: 1 / -1;
  padding-top: 20px;
  border-top: 1px solid rgba(223,193,138,.15);
  color: #829285;
  font-size: 8px;
  letter-spacing: 1.4px;
}

@keyframes image-reveal {
  from { opacity: .6; transform: scale(1.045); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes content-reveal {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 900px) {
  .hero-stamp { display: none; }

  .intro-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .approach {
    gap: 45px;
  }

  .contact-decoration {
    right: -110px;
    opacity: .45;
  }
}

@media (max-width: 700px) {
  .section-pad {
    padding: 75px 7%;
  }

  .site-header {
    padding: 18px 6%;
  }

  .brand .orbit-mark {
    width: 37px;
    height: 37px;
  }

  .brand-copy strong { font-size: 11px; }
  .brand-copy small { font-size: 7px; letter-spacing: 2.6px; }

  .menu-toggle {
    z-index: 10;
    display: block;
  }

  .nav-links {
    position: absolute;
    z-index: 8;
    top: 75px;
    right: 6%;
    left: 6%;
    display: none;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 12px 20px;
    border: 1px solid rgba(223,193,138,.35);
    background: #10271d;
  }

  .nav-links.nav-open { display: flex; }

  .nav-links a {
    padding: 15px 4px;
    border-bottom: 1px solid rgba(223,193,138,.12);
  }

  .nav-links .nav-contact {
    margin-top: 10px;
    text-align: center;
  }

  .hero-layout {
    padding: 85px 7% 90px;
  }

  .hero h1 {
    font-size: clamp(47px, 10vw, 70px);
    letter-spacing: -1.5px;
  }

  .hero-description {
    font-size: 13px;
  }

  .hero-bottom {
    flex-wrap: wrap;
    padding: 17px 6%;
    font-size: 8px;
  }

  .hero-bottom-center { display: none; }

  .principles {
    grid-template-columns: 1fr;
    gap: 18px;
    margin-top: 45px;
  }

  .section-heading {
    display: block;
  }

  .section-heading > p {
    margin-top: 22px;
  }

  .service-grid, .project-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .service-card { min-height: 310px; }

  .project-art { aspect-ratio: 1.35; }

  .approach {
    grid-template-columns: 1fr;
    gap: 60px;
  }

  .approach-visual {
    width: min(100%, 350px);
  }

  .contact-section {
    padding: 80px 7%;
  }

  .contact-decoration {
    top: auto;
    right: -120px;
    bottom: -150px;
    transform: none;
  }

  .site-footer {
    grid-template-columns: 1fr auto;
    gap: 20px;
    padding: 28px 7%;
  }

  .site-footer > p {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0;
  }

  .back-top {
    grid-column: 2;
    grid-row: 1;
  }

  .copyright { grid-row: 3; }
}

@media (max-width: 400px) {
  .eyebrow, .section-kicker {
    font-size: 8px;
    letter-spacing: 2px;
  }

  .hero h1 { font-size: 45px; }

  .hero-buttons {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
  }

  .button { padding: 15px 16px; }

  .intro h2, .section-heading h2 {
    font-size: 38px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}


/* ===== DATA ORBIT: NATURE BACKGROUND FIX ===== */
.hero {
  background-color: #09251b !important;
  background-image:
    linear-gradient(90deg, rgba(5, 24, 18, 0.78) 0%, rgba(5, 24, 18, 0.42) 55%, rgba(5, 24, 18, 0.16) 100%),
    url("https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=2400&q=90") !important;
  background-size: cover !important;
  background-position: center 48% !important;
  background-repeat: no-repeat !important;
}

/* Prevent the old image element from covering the new background */
.hero .hero-image {
  display: none !important;
}

/* Keep hero text readable */
.hero .hero-content,
.hero .hero-inner {
  position: relative;
  z-index: 2;
}

/* Mountain and lake nature scene for the approach section */
.approach {
  background-color: #102d23 !important;
  background-image:
    linear-gradient(rgba(6, 27, 20, 0.68), rgba(6, 27, 20, 0.76)),
    url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2000&q=85") !important;
  background-size: cover !important;
