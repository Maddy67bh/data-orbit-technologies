import { initPremiumEffects } from "./premium-effects.js";
import "./premium-effects.css";
import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
import SakuraHero from "./SakuraHero";
import "./index.css";

createRoot(document.getElementById("root")).render(
  <StrictMode>
    <SakuraHero />
  </StrictMode>
);

if (typeof document !== "undefined") {
  const startPremiumEffects = () => initPremiumEffects();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startPremiumEffects, { once: true });
  } else {
    startPremiumEffects();
  }
}

// DATA_ORBIT_CARD_ROUTING_V1
// Route each homepage service card to its own dedicated page.
if (typeof document !== "undefined" && typeof window !== "undefined") {
  document.addEventListener("click", function (event) {
    const titles = [
      {
        title: "Data & Analytics",
        url: "/services/data-analytics/"
      },
      {
        title: "Artificial Intelligence",
        url: "/services/artificial-intelligence/"
      },
      {
        title: "Digital Experiences",
        url: "/services/digital-experiences/"
      }
    ];

    let current = event.target;
    let depth = 0;

    while (current && current !== document.body && depth < 12) {
      if (current instanceof HTMLElement) {
        const text = (current.innerText || current.textContent || "")
          .replace(/\s+/g, " ")
          .trim();

        const matches = titles.filter(item =>
          text.toLowerCase().includes(item.title.toLowerCase())
        );

        // Route only when this element represents one service,
        // not a parent section containing several service cards.
        if (matches.length === 1) {
          const item = matches[0];
          const isCard =
            current.matches(
              "article, button, a, [role='button'], .service-card, .project-card, .portfolio-card"
            ) ||
            /card|service|portfolio|project|clickable/i.test(
              typeof current.className === "string" ? current.className : ""
            ) ||
            current.hasAttribute("data-service-card");

          if (isCard) {
            const destination = new URL(item.url, window.location.origin);

            // Only handle these cards on the homepage.
            const path = window.location.pathname.replace(/\/+$/, "") || "/";
            if (path !== "/" && path !== "/index.html") return;

            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();

            window.location.assign(destination.href);
            return;
          }
        }
      }

      current = current.parentElement;
      depth++;
    }
  }, true);
}
// END DATA_ORBIT_CARD_ROUTING_V1
