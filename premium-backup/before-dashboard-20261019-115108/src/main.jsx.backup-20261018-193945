        <span className="predict-label label-one">PATTERNS</span>
        <span className="predict-label label-two">PREDICTIONS</span>
      </div>
    );
  }

  return (
    <div className="network-visual">
      <div className="network-grid" />
      <div className="network-center"><Sparkles size={30} /></div>
      {Array.from({ length: 12 }, (_, i) => (
