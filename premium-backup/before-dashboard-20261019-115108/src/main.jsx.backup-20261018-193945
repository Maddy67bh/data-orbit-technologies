function ContactSection() {
  const [form, setForm] = useState({ name: "", email: "", service: "Data & Analytics", message: "" });

  function submitForm(event) {
    event.preventDefault();
    const subject = encodeURIComponent(`Project enquiry — ${form.service}`);
    const body = encodeURIComponent(
      `Name: ${form.name}\nEmail: ${form.email}\nService: ${form.service}\n\nProject details:\n${form.message}`
    );
    window.location.href = `mailto:hello@dataorbittechnologies.com?subject=${subject}&body=${body}`;
  }

  return (
    <section className="contact-section section-pad" id="contact">
      <div className="contact-glow" />
      <div className="contact-layout">
        <div className="contact-copy">
          <div className="eyebrow"><span /> LET'S BUILD SOMETHING MEANINGFUL</div>
          <h2>Have a challenge?<br /><em>Let's solve it.</em></h2>
          <p>Tell us what you're working on. Let's explore how data, AI and engineering can move your idea forward.</p>
          <a className="contact-email" href="mailto:hello@dataorbittechnologies.com">
            <Mail size={17} /> hello@dataorbittechnologies.com <ArrowUpRight size={15} />
          </a>
          <div className="contact-note"><span /> OPEN TO NEW PROJECT ENQUIRIES</div>
        </div>

        <form className="contact-form" onSubmit={submitForm}>
          <div className="form-heading"><span>PROJECT ENQUIRY</span><span>01 — 04</span></div>
          <label>
            Your name
            <input required value={form.name} onChange={e => setForm({ ...form, name: e.target.value })} placeholder="How should we address you?" />
          </label>
          <label>
            Work email
            <input required type="email" value={form.email} onChange={e => setForm({ ...form, email: e.target.value })} placeholder="you@company.com" />
          </label>
          <label>
            What do you need?
            <select value={form.service} onChange={e => setForm({ ...form, service: e.target.value })}>
              <option>Data & Analytics</option>
              <option>Artificial Intelligence</option>
              <option>Web Development</option>
              <option>Automation</option>
              <option>Data Strategy</option>
              <option>Something else</option>
            </select>
          </label>
          <label>
            Tell us about your project
            <textarea required rows="3" value={form.message} onChange={e => setForm({ ...form, message: e.target.value })} placeholder="A little context helps us get started..." />
          </label>
          <button className="submit-button" type="submit">Send project enquiry <ArrowUpRight size={17} /></button>
          <p className="form-footnote">Your email app will open with your enquiry prepared for sending.</p>
        </form>
      </div>
    </section>
  );
}

