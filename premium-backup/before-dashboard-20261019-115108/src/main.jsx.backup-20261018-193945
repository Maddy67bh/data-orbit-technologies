        <div className="chart-area">
          <div className="chart-y"><i /><i /><i /><i /></div>
          <svg viewBox="0 0 360 105" preserveAspectRatio="none" aria-label="Illustrative analytics chart">
            <defs>
              <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stopColor="#68efa4" stopOpacity=".32" />
                <stop offset="100%" stopColor="#68efa4" stopOpacity="0" />
