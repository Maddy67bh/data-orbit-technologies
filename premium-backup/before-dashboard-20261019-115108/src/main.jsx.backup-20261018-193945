            </defs>
            <path d="M0 83 C30 76 37 86 64 63 S104 76 134 49 S177 63 205 37 S246 54 274 26 S322 42 360 8 L360 105 L0 105Z" fill="url(#chartFill)" />
            <path d="M0 83 C30 76 37 86 64 63 S104 76 134 49 S177 63 205 37 S246 54 274 26 S322 42 360 8" fill="none" stroke="#75f2ae" strokeWidth="2" />
          </svg>
        </div>
        <div className="chart-bottom"><span>WEEK 01</span><span>WEEK 02</span><span>WEEK 03</span><span>WEEK 04</span></div>
      </div>
    );
  }

  if (type === "visual-predict") {
    return (
      <div className="predict-visual">
        <div className="predict-orbit orbit-one" />
        <div className="predict-orbit orbit-two" />
        <div className="predict-core"><BrainCircuit size={37} strokeWidth={1.2} /></div>
        <span className="predict-node node-one" />
        <span className="predict-node node-two" />
