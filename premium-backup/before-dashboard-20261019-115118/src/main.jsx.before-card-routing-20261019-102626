import { initPremiumEffects } from "./premium-effects.js";
import "./premium-effects.css";
import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
import SakuraHero from "./SakuraHero";
import "./index.css";

createRoot(document.getElementById("root")).render(
  <StrictMode>
    <SakuraHero />
  </StrictMode>
);

if (typeof document !== "undefined") {
  const startPremiumEffects = () => initPremiumEffects();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startPremiumEffects, { once: true });
  } else {
    startPremiumEffects();
  }
}