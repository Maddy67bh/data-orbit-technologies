.nature-world {
  --cream: #f5f1e7;
  --gold: #d8c19a;
  position: relative;
  isolation: isolate;
  width: 100%;
  height: min(850px, 92vh);
  min-height: 690px;
  overflow: hidden;
  background: #142b22;
  color: var(--cream);
  font-family: inherit;
}

.nature-image,
.nature-atmosphere,
.nature-grain {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.nature-image {
  z-index: -3;
  background:
    url("https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=2400&q=90")
    center 50% / cover no-repeat;
  transform: scale(1.03);
  animation: nature-drift 28s ease-in-out infinite alternate;
  transition: filter 1.2s ease;
}

.nature-night .nature-image {
  filter: brightness(.38) saturate(.7) hue-rotate(12deg);
}

.nature-atmosphere {
  z-index: -2;
  background:
    linear-gradient(90deg, rgba(7,22,17,.89) 0%, rgba(7,22,17,.69) 34%, rgba(7,22,17,.16) 75%, rgba(7,22,17,.08)),
    linear-gradient(0deg, rgba(5,17,13,.72), transparent 27%, transparent 76%, rgba(5,17,13,.35));
  transition: background 1s ease;
}

.nature-night .nature-atmosphere {
  background:
    linear-gradient(90deg, rgba(3,14,17,.92), rgba(3,14,17,.7) 38%, rgba(3,14,17,.18)),
    linear-gradient(0deg, rgba(3,12,15,.8), transparent 55%, rgba(3,12,15,.4));
}

.nature-grain {
  z-index: -1;
  opacity: .12;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.28'/%3E%3C/svg%3E");
}

.nature-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 27px clamp(22px, 5.5vw, 84px);
  border-bottom: 1px solid rgba(245,241,231,.18);
}

.nature-brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.nature-mark {
  font-family: Georgia, serif;
  font-size: 32px;
  letter-spacing: -.1em;
  color: var(--cream);
}

.nature-mark span { color: var(--gold); }

.nature-brand b,
.nature-brand small {
  display: block;
  font-size: 10px;
  letter-spacing: .18em;
}

.nature-brand b { font-weight: 600; }
.nature-brand small {
  margin-top: 5px;
  color: rgba(245,241,231,.63);
  font-size: 8px;
  letter-spacing: .15em;
}

.nature-edition {
  font-size: 9px;
  letter-spacing: .18em;
  color: rgba(245,241,231,.72);
}

.nature-copy {
  position: absolute;
  top: 48%;
  left: clamp(24px, 10vw, 150px);
  width: min(580px, 78%);
  transform: translateY(-43%);
  animation: nature-enter 1.1s ease-out both;
}

.nature-eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .23em;
  color: #e2d0ad;
}

.nature-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--gold);
  box-shadow: 0 0 0 4px rgba(216,193,154,.15);
}

.nature-copy h2 {
  margin: 29px 0 22px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(58px, 7.6vw, 108px);
  font-weight: 400;
  line-height: .92;
  letter-spacing: -.075em;
}

.nature-copy h2 em {
  color: #e3cba4;
  font-weight: 400;
}

.nature-copy p {
  max-width: 370px;
  margin: 0;
  color: rgba(245,241,231,.82);
  font-size: 14px;
  line-height: 1.95;
}

.nature-controls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 23px;
  margin-top: 32px;
}

.nature-button {
  display: inline-flex;
  align-items: center;
  gap: 24px;
  padding: 9px 10px 9px 20px;
  min-height: 50px;
  border: 1px solid rgba(245,241,231,.65);
  border-radius: 2px;
  background: #eee5d3;
  color: #1b3428;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: transform .25s ease, background .25s ease;
}

.nature-button:hover {
  transform: translateY(-2px);
  background: #fff9ed;
}

.nature-button span {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border: 1px solid rgba(27,52,40,.2);
  font-size: 16px;
}

.nature-note {
  font-size: 8px;
  letter-spacing: .15em;
  color: rgba(245,241,231,.7);
}

.nature-bottom {
  position: absolute;
  left: clamp(22px, 5.5vw, 84px);
  right: clamp(22px, 5.5vw, 84px);
  bottom: 27px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding-top: 21px;
  border-top: 1px solid rgba(245,241,231,.24);
}

.nature-place {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nature-symbol {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 1px solid rgba(245,241,231,.38);
  border-radius: 50%;
  color: var(--gold);
  font-size: 20px;
}

.nature-place b,
.nature-place small {
  display: block;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: .14em;
}

.nature-place small {
  margin-top: 6px;
  color: rgba(245,241,231,.62);
  font-size: 8px;
}

.nature-scroll {
  display: flex;
  align-items: center;
  gap: 12px;
  color: rgba(245,241,231,.68);
  font-size: 8px;
  letter-spacing: .16em;
}

.nature-scroll i {
  width: 36px;
  height: 1px;
  background: var(--gold);
  animation: nature-line 2s ease-in-out infinite;
}

.nature-number {
  font-family: Georgia, serif;
  font-size: 19px;
}

.nature-number i {
  color: rgba(245,241,231,.5);
  font-size: 12px;
  font-style: normal;
}

.nature-petals {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.nature-petals span {
  position: absolute;
  left: var(--left);
  top: -15%;
  width: 5px;
  height: 9px;
  border-radius: 80% 10% 80% 10%;
  background: rgba(244,207,210,.75);
  opacity: 0;
  animation: nature-fall var(--speed) var(--delay) linear infinite;
}

.nature-night .nature-petals span {
  background: rgba(220,190,220,.65);
}

@keyframes nature-drift {
  from { transform: scale(1.03) translate3d(0,0,0); }
  to { transform: scale(1.09) translate3d(-.4%,.3%,0); }
}

@keyframes nature-enter {
  from { opacity: 0; translate: 0 18px; }
  to { opacity: 1; translate: 0 0; }
}

@keyframes nature-line {
  0%, 100% { transform: scaleX(.5); opacity: .5; }
  50% { transform: scaleX(1); opacity: 1; }
}

@keyframes nature-fall {
  0% { transform: translateY(-5vh) rotate(0); opacity: 0; }
  15% { opacity: .65; }
  80% { opacity: .55; }
  100% { transform: translate(-65px,115vh) rotate(480deg); opacity: 0; }
}

@media (max-width: 700px) {
  .nature-world { min-height: 690px; height: 88svh; }
  .nature-image { background-position: 57% center; }
  .nature-top { padding: 21px 20px; }
  .nature-edition { max-width: 100px; text-align: right; line-height: 1.7; font-size: 8px; }
  .nature-copy { left: 24px; width: calc(100% - 48px); top: 46%; }
  .nature-copy h2 { font-size: clamp(57px, 13vw, 82px); }
  .nature-copy p { max-width: 310px; font-size: 13px; }
  .nature-bottom { left: 20px; right: 20px; bottom: 21px; }
  .nature-scroll { display: none; }
  .nature-note { max-width: 100px; line-height: 1.7; }
}

@media (prefers-reduced-motion: reduce) {
  .nature-image, .nature-copy, .nature-scroll i, .nature-petals span {
    animation: none !important;
  }
}
